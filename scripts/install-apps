#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
dry_run=false
if [[ "${1:-}" == --dry-run ]]; then dry_run=true; shift; fi
selection="${1:-all}"
case "$selection" in all|flatpak|vscode) ;; *)
    echo "Usage: bash scripts/install-apps [--dry-run] [all|flatpak|vscode]" >&2; exit 2 ;;
esac
[[ "$(uname -s)" == Linux ]] || {
    echo "App installation currently supports Linux only." >&2; exit 1;
}
[[ $EUID -ne 0 ]] || { echo "Run this command as your normal user." >&2; exit 1; }
run() {
    if "$dry_run"; then printf '%q ' "$@"; printf '\n'; else "$@"; fi
}
install_flatpaks() {
    run flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    while IFS= read -r app; do
        app="${app%%#*}"
        [[ -z "$app" ]] || run flatpak install --user --noninteractive -y flathub "$app"
    done < "$repo/apps/linux/flatpak.txt"
}
install_vscode() (
    if "$dry_run"; then
        echo "Install native VS Code in the user data directory and create the code launcher."
        return
    fi
    case "$(uname -m)" in x86_64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *)
        echo "Unsupported VS Code architecture." >&2; exit 1 ;;
    esac
    stage=$(mktemp -d)
    trap 'rm -rf "$stage"' EXIT
    curl --fail --silent --show-error --location \
        "https://update.code.visualstudio.com/api/update/linux-$arch/stable/latest" > "$stage/release.json"
    url=$(jq -er '.url | select(startswith("https://"))' "$stage/release.json")
    checksum=$(jq -er '.sha256hash | select(test("^[a-fA-F0-9]{64}$"))' "$stage/release.json")
    version=$(jq -er '.version | select(test("^[a-fA-F0-9]{40}$"))' "$stage/release.json")
    curl --fail --silent --show-error --location "$url" -o "$stage/code.tar.gz"
    printf '%s  %s\n' "$checksum" "$stage/code.tar.gz" | sha256sum --check -
    data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"
    app_dir="$data_dir/vscode"
    launcher="$HOME/.local/bin/code"
    if [[ -e "$launcher" || -L "$launcher" ]]; then
        [[ -L "$launcher" && "$(readlink "$launcher")" == "$app_dir/current/bin/code" ]] || {
            echo "The existing $launcher is not managed by this installer. Move it before installing." >&2
            exit 1
        }
    fi
    mkdir -p "$app_dir" "$HOME/.local/bin" "$data_dir/applications" "$stage/unpacked"
    tar -xzf "$stage/code.tar.gz" --strip-components=1 -C "$stage/unpacked"
    [[ -x "$stage/unpacked/bin/code" && -x "$stage/unpacked/code" ]]
    if [[ ! -d "$app_dir/$version" ]]; then mv "$stage/unpacked" "$app_dir/$version"; fi
    ln -sfn "$version" "$app_dir/current"
    ln -sfn "$app_dir/current/bin/code" "$launcher"
    escaped_dir=${app_dir//\\/\\\\}
    escaped_dir=${escaped_dir//\"/\\\"}
    cat > "$data_dir/applications/code.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Visual Studio Code
Exec="$escaped_dir/current/code" %F
Icon=$app_dir/current/resources/app/resources/linux/code.png
Terminal=false
Categories=Development;IDE;
MimeType=text/plain;inode/directory;
EOF
    echo "Installed VS Code. Run this command again to update it."
)
if [[ "$selection" == all || "$selection" == flatpak ]]; then install_flatpaks; fi
if [[ "$selection" == all || "$selection" == vscode ]]; then install_vscode; fi
