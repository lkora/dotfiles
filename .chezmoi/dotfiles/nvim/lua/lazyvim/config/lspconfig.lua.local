-- =============================================================================
-- Local LazyVim Configuration Override
-- Purpose: Override defaults without duplicating the entire config
-- Design: Modular, versioned, can be committed to git
-- =============================================================================

-- Example: Custom LSP settings for your preferred LSP servers
LspConfig.setup {
  -- Mappings
  mappings = {
    n = {
      ["<leader>rn"] = "<cmd>lua vim.lsp.buf.rename()<cr>",
      ["<leader>ca"] = "<cmd>lua vim.lsp.buf.code_action()<cr>",
      ["<leader>gd"] = "<cmd>lua vim.lsp.buf.definition()<cr>",
      ["<leader>gi"] = "<cmd>lua vim.lsp.buf.implementation()<cr>",
      ["<leader>hw"] = "<cmd>lua vim.lsp.buf.hover()<cr>",
      ["<leader>qf"] = "<cmd>Telescope diagnostics.buf<cr>",
    },
  },

  -- Treesitter context
  treesitter = {
    enabled = true,
  },

  -- Inlay hints
  inlay_hints = {
    enabled = true,
  },

  -- Document links
  document_link = {
    enabled = true,
  },

  -- Document highlight
  document_highlight = {
    enabled = true,
  },
}

-- Example: LSP servers configuration
LspConfig.servers = {
  -- Lua
  ["lua_ls"] = {
    cmd = { "/usr/local/bin/lua-language-server", "--root-dir", "%l" },
    filetypes = { "lua", "luau" },
    settings = {
      Lua = {
        diagnostics = {
          globals = { "vim" },
        },
      },
    },
  },

  -- Python
  ["pylsp"] = {
    cmd = { "/usr/bin/pylsp" },
    filetypes = { "python" },
    settings = {
      python = {
        analyze = {
          typeCheckingMode = "basic",
        },
      },
    },
  },

  -- TypeScript/JavaScript
  ["tailwindcss_lsp"] = {
    cmd = { "/usr/bin/tailwindcss-language-server" },
    filetypes = { "typescript", "javascript" },
  },

  -- HTML
  ["html"] = {
    cmd = { "/usr/bin/vls" },
    filetypes = { "html" },
  },

  -- CSS
  ["cssls"] = {
    cmd = { "/usr/bin/vls" },
    filetypes = { "css" },
  },
}

-- Example: Custom diagnostics settings
vim.diagnostic.config({
  virtual_text = {
    format = function(diagnostic)
      local sign = string.sub(diagnostic.sign, 1, 1)
      local msg = string.sub(diagnostic.message, 1, 50)
      return (sign .. " " .. msg)
    end,
    update_in_insert = true,
    severity_sort = true,
  },

  signs = {
    text = {
      [vim.diagnostic.severity.ERROR] = "✗",
      [vim.diagnostic.severity.WARN] = "⚠",
      [vim.diagnostic.severity.INFO] = "ℹ",
      [vim.diagnostic.severity.HINT] = "󰡘",
    },
  },
})

-- Example: Completion settings
vim.api.nvim_create_autocmd("LspAttach", {
  callback = function(event)
    local client = vim.lsp.get_client_by_id(event.data.client_id)
    if client and client.server_capabilities.completion_item_kind then
      vim.api.nvim_create_autocmd("BufEnter", {
        buffer = event.buf,
        callback = function()
          vim.lsp.buf.enable_completion_item_kind()
        end,
      })
    end
  end,
})
